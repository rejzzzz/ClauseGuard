# ==========================================
# ClauseGuard Environment Variables Template
# ==========================================

# ------------------------------------------
# 1. AWS BEDROCK CREDENTIALS & MODEL CONFIGS
# ------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=ap-south-1

# Amazon Bedrock Foundation Models
BEDROCK_LLM_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
EMBEDDING_DIMENSION=1536

# Model Generation Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE CONFIGS
# ------------------------------------------
DB_PASSWORD=your_db_password
PROJECT_URL=https://your-project.supabase.co
PUBLISHABLE_KEY=sb_publishable_your_key
DIRECT_CONN_STRING=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
DB_CONNECTION_STRING=postgresql://postgres.your-project:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DB_CONNECTION_URI=postgresql://postgres.your-project:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ------------------------------------------
# 3. APPLICATION & API SERVER CONFIGURATIONS
# ------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEFAULT_PLAYBOOK_NAME=sample_vendor_msa
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------
# 4. STORAGE & FILE PATHS
# ------------------------------------------
SESSION_STORAGE_DIR=data/sessions
PLAYBOOK_STORAGE_DIR=backend/config/playbooks
